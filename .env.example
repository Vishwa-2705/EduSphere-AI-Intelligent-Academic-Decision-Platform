# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║       EduSphere AI — Environment Configuration Template                  ║
# ║       Copy this file to .env and fill in your actual values.             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/edusphere_ai
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/edusphere_ai?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=edusphere_super_secret_key_2026_btech_change_in_prod
JWT_REFRESH_SECRET=edusphere_refresh_key_2026_btech_change_in_prod
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Google Gemini AI API ──────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── Python AI Microservice ────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Demo User Seed Credentials ────────────────────────────────────────────────
# All demo accounts use password: Role@12345
# student@edusphere.ai  (STUDENT)
# faculty@edusphere.ai  (FACULTY)
# mentor@edusphere.ai   (MENTOR)
# admin@edusphere.ai    (ADMIN)
